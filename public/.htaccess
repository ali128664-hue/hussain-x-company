<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ══════════════════════════════════════════════════════════
# Canonical Domain Enforcement: https://hussainxsolution.com
# ══════════════════════════════════════════════════════════

# 1. Redirect WWW to non-WWW (HTTP & HTTPS)
RewriteCond %{HTTP_HOST} ^www\.hussainxsolution\.com$ [NC]
RewriteRule ^(.*)$ https://hussainxsolution.com/$1 [L,R=301]

# 2. Force HTTPS (if not already HTTPS)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://hussainxsolution.com/$1 [L,R=301]

# ══════════════════════════════════════════════════════════
# 301 Permanent Redirects for All Legacy & Changed Service Slugs
# ══════════════════════════════════════════════════════════

# Software & SaaS
RewriteRule ^services/custom-software/?$ /services/custom-software-development [R=301,L]
RewriteRule ^services/software-development/?$ /services/custom-software-development [R=301,L]
RewriteRule ^services/saas/?$ /services/saas-application-development [R=301,L]
RewriteRule ^services/mobile-apps/?$ /services/mobile-app-development [R=301,L]
RewriteRule ^services/api-integration/?$ /services/api-integration-services [R=301,L]
RewriteRule ^services/business-automation/?$ /services/business-automation-services [R=301,L]

# Web & Commerce
RewriteRule ^services/web-development/?$ /services/web-development-company [R=301,L]
RewriteRule ^services/ecommerce/?$ /services/ecommerce-website-development [R=301,L]
RewriteRule ^services/ecommerce-solutions/?$ /services/ecommerce-website-development [R=301,L]
RewriteRule ^services/wordpress/?$ /services/wordpress-development-services [R=301,L]
RewriteRule ^services/shopify/?$ /services/shopify-store-development [R=301,L]
RewriteRule ^services/maintenance/?$ /services/website-maintenance-support [R=301,L]
RewriteRule ^services/website-support/?$ /services/website-maintenance-support [R=301,L]

# Design & Creative
RewriteRule ^services/ui-ux-design/?$ /services/ui-ux-design-services [R=301,L]
RewriteRule ^services/branding/?$ /services/branding-and-creative-agency [R=301,L]
RewriteRule ^services/branding-creative/?$ /services/branding-and-creative-agency [R=301,L]
RewriteRule ^services/logo-design/?$ /services/professional-logo-design [R=301,L]
RewriteRule ^services/video-editing/?$ /services/professional-video-editing [R=301,L]
RewriteRule ^services/creative-design/?$ /services/creative-design-services [R=301,L]

# Marketing & Growth
RewriteRule ^services/seo-services/?$ /services/seo-services-company [R=301,L]
RewriteRule ^services/social-media-marketing/?$ /services/social-media-marketing-services [R=301,L]
RewriteRule ^services/ppc/?$ /services/ppc-advertising-management [R=301,L]
RewriteRule ^services/digital-marketing/?$ /services/digital-marketing-services [R=301,L]
RewriteRule ^services/content-marketing/?$ /services/content-marketing-services [R=301,L]

# Technology & Cloud
RewriteRule ^services/ai-automation/?$ /services/ai-automation-solutions [R=301,L]
RewriteRule ^services/cloud-devops/?$ /services/cloud-devops-services [R=301,L]
RewriteRule ^services/cyber-security/?$ /services/cyber-security-services [R=301,L]
RewriteRule ^services/qa-testing/?$ /services/software-qa-testing [R=301,L]
RewriteRule ^services/database/?$ /services/database-development-services [R=301,L]

# ══════════════════════════════════════════════════════════
# React Router SPA Catch-All
# ══════════════════════════════════════════════════════════
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>

# Allow CORS and set charset for LLM & AI agent files
<FilesMatch "^(llms|llms-full)\.txt$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Content-Type "text/plain; charset=utf-8"
    </IfModule>
</FilesMatch>

<FilesMatch "^ai-catalog\.json$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Content-Type "application/json; charset=utf-8"
    </IfModule>
</FilesMatch>

# ══════════════════════════════════════════════════════════
# Browser Caching & Performance Optimization
# ══════════════════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
